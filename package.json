{
	"name": "bubbles",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"dev": "pnpm dev:desktop",
		"dev:desktop": "pnpm --filter @bubbles/desktop dev",
		"dev:renderer": "pnpm --filter @bubbles/renderer dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"e2e": "pnpm --filter @bubbles/desktop build && playwright test",
		"verify": "tsx scripts/verify.ts",
		"eval": "tsx scripts/eval-judge.ts",
		"seed-presets": "tsx scripts/seed-presets.ts",
		"postinstall": "node ./node_modules/electron/install.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@playwright/test": "^1.50.0",
		"@types/node": "^22.10.0",
		"electron": "^32.3.3",
		"playwright": "^1.50.0",
		"tsx": "^4.19.2",
		"turbo": "^2.3.3",
		"typescript": "~5.6.3"
	},
	"engines": {
		"node": ">=22"
	}
}
